# =======================================================================
# Alloy Vault - TrueNAS SCALE & PostgreSQL Environment Configuration
# =======================================================================

# Server Port (Default: 3000)
PORT=3000

# Node Environment ('production' or 'development')
NODE_ENV=production

# Secret key for encrypting session cookies
# (Replace with a random secure string in production)
SESSION_SECRET=alloy_vault_secret_session_key_production_2026

# =======================================================================
# Master Administrator Credentials
# Manage users, provision Factory Manager & Accounts credentials
# =======================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminVault2026!

# =======================================================================
# PostgreSQL Connection Setup for TrueNAS SCALE
# (You can configure either OPTION A or OPTION B)
# =======================================================================

# -----------------------------------------------------------------------
# OPTION A: Single Connection URI String
# Set DATABASE_URL in your TrueNAS SCALE Custom App / Docker environment:
# -----------------------------------------------------------------------
DATABASE_URL=postgres://alloy_user:alloy_password@postgres:5432/alloy_db

# -----------------------------------------------------------------------
# OPTION B: Discrete TrueNAS Environment Variables
# If you prefer setting credentials as separate fields in TrueNAS SCALE:
# -----------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=alloy_db
POSTGRES_USER=alloy_user
POSTGRES_PASSWORD=alloy_password

# Optional: Set to 'true' if connecting to an external cloud database requiring SSL
# (keep 'false' for internal TrueNAS local network / Docker bridge)
POSTGRES_SSL=false
