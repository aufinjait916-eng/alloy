<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Alloy &amp; Melting Inventory Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <%- include('partials/theme_head') %>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between selection:bg-amber-500 selection:text-slate-950 font-sans transition-colors">

  <!-- Header Branding -->
  <header class="border-b border-slate-800 bg-slate-900/60 backdrop-blur-md px-6 py-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-gradient-to-tr from-amber-600 via-amber-500 to-yellow-400 flex items-center justify-center shadow-lg shadow-amber-500/20 text-slate-950 font-bold text-xl">
          ⚱
        </div>
        <div>
          <h1 class="text-lg font-bold text-white tracking-wide">ALLOY &amp; MELTING INVENTORY</h1>
          <p class="text-xs text-slate-400 font-mono">Vault System</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <button 
          type="button" 
          id="themeToggleBtnLogin"
          onclick="toggleLoginTheme()" 
          title="Toggle Light / Dark Mode"
          class="p-2 rounded-xl text-slate-400 hover:text-amber-400 hover:bg-slate-800/80 border border-transparent hover:border-slate-700 transition flex items-center justify-center cursor-pointer"
        >
          <svg id="loginSunIcon" class="w-4 h-4 hidden text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg id="loginMoonIcon" class="w-4 h-4 hidden text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
        <div class="flex items-center gap-2 text-xs font-mono text-emerald-400 bg-emerald-950/60 border border-emerald-800/80 px-3 py-1 rounded-full">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Secure Vault Portal</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Login Main Content -->
  <main class="flex-1 flex items-center justify-center px-4 py-8 sm:py-12">
    <div class="w-full max-w-md">

      <!-- Card Container -->
      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl backdrop-blur-xl relative overflow-hidden">
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="mb-6">
          <span class="text-xs font-semibold uppercase tracking-wider text-amber-400 bg-amber-950/60 border border-amber-800/60 px-2.5 py-1 rounded-md font-mono">
            Vault Authentication
          </span>
          <h2 class="text-2xl font-bold text-white mt-3">Sign In to Vault</h2>
          <p class="text-sm text-slate-400 mt-1">Authenticate your session to access inventory ledgers and melting operations.</p>
        </div>

        <% if (error) { %>
          <div class="mb-5 p-3.5 rounded-lg bg-rose-950/80 border border-rose-800/80 text-rose-300 text-sm flex items-start gap-2.5">
            <svg class="w-5 h-5 text-rose-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span><%= error %></span>
          </div>
        <% } %>

        <% if (message) { %>
          <div class="mb-5 p-3.5 rounded-lg bg-emerald-950/80 border border-emerald-800/80 text-emerald-300 text-sm flex items-start gap-2.5">
            <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span><%= message %></span>
          </div>
        <% } %>

        <!-- Standard Login Form -->
        <form action="/login" method="POST" class="space-y-4" id="loginForm">
          <div>
            <label for="username" class="block text-xs font-medium text-slate-300 mb-1.5 uppercase tracking-wider">Username</label>
            <div class="relative">
              <input 
                type="text" 
                id="username" 
                name="username" 
                required 
                autocomplete="username"
                value="<%= typeof username !== 'undefined' ? username : '' %>"
                placeholder="Enter your username" 
                class="w-full bg-slate-950 border border-slate-700 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 rounded-lg px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition"
              />
            </div>
          </div>

          <div>
            <label for="password" class="block text-xs font-medium text-slate-300 mb-1.5 uppercase tracking-wider">Password</label>
            <div class="relative">
              <input 
                type="password" 
                id="password" 
                name="password" 
                required 
                autocomplete="current-password"
                placeholder="Enter your password" 
                class="w-full bg-slate-950 border border-slate-700 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 rounded-lg px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition"
              />
            </div>
          </div>

          <button 
            type="submit" 
            class="w-full mt-3 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-semibold py-2.5 px-4 rounded-lg shadow-lg shadow-amber-500/20 active:scale-[0.99] transition duration-150 text-sm flex items-center justify-center gap-2"
          >
            <span>Sign In to Vault</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>

      </div>

      <!-- Footer Info -->
      <div class="mt-6 text-center text-xs text-slate-500">
        TrueNAS SCALE Environment Compatible &bull; PostgreSQL Protected
      </div>
    </div>
  </main>

  <footer class="border-t border-slate-900 py-4 text-center text-xs text-slate-500">
    Alloy &amp; Melting Inventory Manager &bull; Pure Node.js WebApp
  </footer>

  <script>
    function updateLoginThemeIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      const sun = document.getElementById('loginSunIcon');
      const moon = document.getElementById('loginMoonIcon');
      if (sun && moon) {
        if (isDark) {
          sun.classList.remove('hidden');
          moon.classList.add('hidden');
        } else {
          sun.classList.add('hidden');
          moon.classList.remove('hidden');
        }
      }
    }

    function toggleLoginTheme() {
      const isDark = document.documentElement.classList.contains('dark');
      const nextTheme = isDark ? 'light' : 'dark';
      if (nextTheme === 'dark') {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
      } else {
        document.documentElement.classList.add('light');
        document.documentElement.classList.remove('dark');
      }
      try { localStorage.setItem('vault_theme', nextTheme); } catch(e){}
      updateLoginThemeIcons();
    }

    try {
      sessionStorage.removeItem('alloy_auth_token');
      localStorage.removeItem('alloy_auth_token');
    } catch(e) {}

    document.addEventListener('DOMContentLoaded', updateLoginThemeIcons);
  </script>
</body>
</html>
