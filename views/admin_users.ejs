<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Management Admin Panel - Alloy Vault</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">
  <%- include('partials/navbar') %>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Admin User Management</h1>
          <span class="text-xs font-mono bg-purple-950 text-purple-300 border border-purple-800 px-2.5 py-1 rounded-full font-semibold">
            Administrator Only
          </span>
        </div>
        <p class="text-sm text-slate-400 mt-1">
          Provision user accounts, configure operational roles (<code class="text-amber-400 font-mono">FactoryManager</code> vs <code class="text-emerald-400 font-mono">Accounts</code>), and manage credentials.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a 
          href="<%= authUrl('/admin/email-settings') %>" 
          class="inline-flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-blue-300 border border-slate-700 hover:border-blue-500/50 shadow-md transition"
        >
          <span>📧 Email Reports</span>
        </a>
        <button 
          type="button" 
          onclick="openCreateUserModal()"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white shadow-lg shadow-purple-600/20 active:scale-95 transition"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
          </svg>
          <span>Provision New User</span>
        </button>
      </div>
    </div>

    <!-- Alert / Toast Messages -->
    <% if (typeof query !== 'undefined' && query.msg) { %>
      <div class="mb-6 p-4 rounded-xl bg-emerald-950/80 border border-emerald-800/80 text-emerald-300 text-sm flex items-center justify-between shadow-lg">
        <div class="flex items-center gap-2.5">
          <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>
            <% if (query.msg === 'user_created') { %> User account provisioned and credentials saved successfully. <% } %>
            <% if (query.msg === 'password_reset') { %> Password has been updated and hashed securely. <% } %>
            <% if (query.msg === 'role_updated') { %> User role permissions successfully updated. <% } %>
            <% if (query.msg === 'user_deleted') { %> User account removed from the vault ledger. <% } %>
          </span>
        </div>
        <button onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-emerald-200 text-xs font-mono">Dismiss</button>
      </div>
    <% } %>

    <% if (typeof query !== 'undefined' && query.error) { %>
      <div class="mb-6 p-4 rounded-xl bg-rose-950/80 border border-rose-800/80 text-rose-300 text-sm flex items-center justify-between shadow-lg">
        <div class="flex items-center gap-2.5">
          <svg class="w-5 h-5 text-rose-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span><%= query.error %></span>
        </div>
        <button onclick="this.parentElement.remove()" class="text-rose-400 hover:text-rose-200 text-xs font-mono">Dismiss</button>
      </div>
    <% } %>

    <!-- Metric Overview Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      <!-- Total Users -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-5 shadow-lg">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono text-slate-400 uppercase tracking-wider">Total Users</span>
          <span class="w-2.5 h-2.5 rounded-full bg-purple-400"></span>
        </div>
        <div class="text-2xl font-bold text-white mt-2 font-mono"><%= users.length %></div>
        <div class="text-[11px] text-slate-500 mt-1">Active ledger accounts</div>
      </div>

      <!-- Factory Managers -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-5 shadow-lg">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono text-slate-400 uppercase tracking-wider">Factory Managers</span>
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
        </div>
        <div class="text-2xl font-bold text-amber-400 mt-2 font-mono">
          <%= users.filter(u => u.role === 'FactoryManager').length %>
        </div>
        <div class="text-[11px] text-slate-500 mt-1">Full CRUD &amp; Melting Run execution</div>
      </div>

      <!-- Accounts Auditors -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-5 shadow-lg">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono text-slate-400 uppercase tracking-wider">Accounts Users</span>
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
        </div>
        <div class="text-2xl font-bold text-emerald-400 mt-2 font-mono">
          <%= users.filter(u => u.role === 'Accounts').length %>
        </div>
        <div class="text-[11px] text-slate-500 mt-1">Read-Only Balance Oversight</div>
      </div>

      <!-- Admin Status -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-5 shadow-lg">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono text-slate-400 uppercase tracking-wider">Master Admin</span>
          <span class="w-2.5 h-2.5 rounded-full bg-indigo-400"></span>
        </div>
        <div class="text-base font-bold text-indigo-300 mt-2 font-mono truncate"><%= adminUsername %></div>
        <div class="text-[11px] text-indigo-400/90 mt-1">Protected by <code class="font-mono text-white">ADMIN_PASSWORD</code></div>
      </div>
    </div>

    <!-- Users Table -->
    <div class="bg-slate-900/80 border border-slate-800 rounded-2xl shadow-xl overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-white">System Accounts Directory</h2>
          <p class="text-xs text-slate-400 mt-0.5">Assigned credentials and permission levels for vault operations</p>
        </div>
        <span class="text-xs font-mono text-slate-500"><%= users.length %> records</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="bg-slate-950/90 text-xs uppercase font-mono text-slate-400 border-b border-slate-800">
            <tr>
              <th scope="col" class="px-6 py-3.5 font-semibold">User ID</th>
              <th scope="col" class="px-6 py-3.5 font-semibold">Username</th>
              <th scope="col" class="px-6 py-3.5 font-semibold">Assigned Role</th>
              <th scope="col" class="px-6 py-3.5 font-semibold">Permissions Level</th>
              <th scope="col" class="px-6 py-3.5 font-semibold">Created Date</th>
              <th scope="col" class="px-6 py-3.5 text-right font-semibold">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80 font-mono">
            <% if (users.length === 0) { %>
              <tr>
                <td colspan="6" class="px-6 py-12 text-center text-slate-500 italic font-sans">
                  No users found in database.
                </td>
              </tr>
            <% } %>

            <% users.forEach(user => { %>
              <tr class="hover:bg-slate-800/40 transition">
                <!-- User ID -->
                <td class="px-6 py-4 font-bold text-slate-400">
                  #<%= user.user_id %>
                </td>

                <!-- Username -->
                <td class="px-6 py-4 text-white font-semibold flex items-center gap-2">
                  <span><%= user.username %></span>
                  <% if (user.role === 'Admin') { %>
                    <span class="text-[10px] bg-purple-950 text-purple-300 border border-purple-800 px-2 py-0.5 rounded-full font-mono font-medium">Master</span>
                  <% } %>
                </td>

                <!-- Role Badge -->
                <td class="px-6 py-4">
                  <% if (user.role === 'Admin') { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-purple-950/80 text-purple-300 border border-purple-800">
                      <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
                      Administrator
                    </span>
                  <% } else if (user.role === 'FactoryManager') { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-950/80 text-amber-300 border border-amber-800">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                      Factory Manager
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-950/80 text-emerald-300 border border-emerald-800">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                      Accounts (Read-Only)
                    </span>
                  <% } %>
                </td>

                <!-- Permissions Summary -->
                <td class="px-6 py-4 font-sans text-xs text-slate-400">
                  <% if (user.role === 'Admin') { %>
                    Full system administration, user management, and read-only oversight
                  <% } else if (user.role === 'FactoryManager') { %>
                    Execute melting charges, manage rules, full IN/OUT transaction CRUD
                  <% } else { %>
                    Read-only stock ledger view, transaction history, and melting session audit
                  <% } %>
                </td>

                <!-- Created At -->
                <td class="px-6 py-4 text-xs text-slate-400 font-sans">
                  <%= user.created_at ? new Date(user.created_at).toLocaleDateString() : 'System Default' %>
                </td>

                <!-- Actions -->
                <td class="px-6 py-4 text-right font-sans whitespace-nowrap">
                  <div class="inline-flex items-center gap-2">
                    <!-- Reset Password Button -->
                    <button 
                      type="button"
                      onclick="openResetPasswordModal('<%= user.user_id %>', '<%= user.username %>')"
                      class="text-xs text-indigo-300 hover:text-white bg-slate-950 hover:bg-indigo-950/60 px-2.5 py-1.5 rounded border border-slate-700 hover:border-indigo-500/50 transition"
                      title="Reset user password"
                    >
                      Reset Password
                    </button>

                    <!-- Change Role (Not available for Admin) -->
                    <% if (user.role !== 'Admin') { %>
                      <button 
                        type="button"
                        onclick="openChangeRoleModal('<%= user.user_id %>', '<%= user.username %>', '<%= user.role %>')"
                        class="text-xs text-amber-300 hover:text-white bg-slate-950 hover:bg-amber-950/60 px-2.5 py-1.5 rounded border border-slate-700 hover:border-amber-500/50 transition"
                        title="Change user role"
                      >
                        Change Role
                      </button>

                      <!-- Delete User -->
                      <form action="<%= authUrl('/admin/users/delete/' + user.user_id) %>" method="POST" class="inline" onsubmit="return confirm('Permanently delete account for user \'<%= user.username %>\'?');">
                        <input type="hidden" name="auth" value="<%= authToken %>">
                        <input type="hidden" name="user_id" value="<%= user.user_id %>">
                        <button 
                          type="submit" 
                          class="text-xs text-rose-400 hover:text-rose-300 bg-slate-950 hover:bg-rose-950/40 px-2.5 py-1.5 rounded border border-slate-700 hover:border-rose-500/50 transition"
                          title="Delete user"
                        >
                          Delete
                        </button>
                      </form>
                    <% } else { %>
                      <span class="text-xs text-slate-500 italic px-2">Primary Admin</span>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Security & Environment Notice -->
    <div class="mt-8 p-4 rounded-xl bg-slate-900 border border-slate-800 text-xs text-slate-400 flex items-start gap-3">
      <span class="text-base text-purple-400">🔒</span>
      <div>
        <strong class="text-white">Admin Security Tip:</strong>
        <p class="mt-0.5 leading-relaxed">
          The master administrator (<code class="text-purple-300 font-mono"><%= adminUsername %></code>) password is synchronized directly with the <code class="text-amber-400 font-mono">ADMIN_PASSWORD</code> environment variable in your TrueNAS SCALE app configuration. All other users created in this panel are stored securely in PostgreSQL with salted bcrypt password hashing.
        </p>
      </div>
    </div>

  </main>

  <!-- ================================================================= -->
  <!-- MODAL 1: Create New User Modal                                    -->
  <!-- ================================================================= -->
  <div id="createUserModal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md p-6 shadow-2xl relative overflow-hidden">
      <div class="flex items-center justify-between pb-4 border-b border-slate-800">
        <div class="flex items-center gap-2">
          <span class="text-purple-400 font-bold text-lg">👤</span>
          <h3 class="text-lg font-bold text-white">Provision New User</h3>
        </div>
        <button type="button" onclick="closeCreateUserModal()" class="text-slate-400 hover:text-white p-1 rounded-lg">✕</button>
      </div>

      <form action="<%= authUrl('/admin/users/create') %>" method="POST" class="mt-5 space-y-4">
        <input type="hidden" name="auth" value="<%= authToken %>">

        <div>
          <label for="create_username" class="block text-xs font-mono uppercase text-slate-300 mb-1.5">Username *</label>
          <input 
            type="text" 
            id="create_username" 
            name="username" 
            required 
            minlength="3" 
            maxlength="30"
            placeholder="e.g. john_manager or sarah_auditor"
            class="w-full bg-slate-950 border border-slate-700 focus:border-purple-500 focus:ring-1 focus:ring-purple-500 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-slate-500 outline-none font-mono"
          />
        </div>

        <div>
          <label for="create_role" class="block text-xs font-mono uppercase text-slate-300 mb-1.5">Role Permission *</label>
          <select 
            id="create_role" 
            name="role" 
            required
            class="w-full bg-slate-950 border border-slate-700 focus:border-purple-500 focus:ring-1 focus:ring-purple-500 rounded-lg px-3.5 py-2.5 text-sm text-white outline-none"
          >
            <option value="FactoryManager">Factory Manager (Full CRUD &amp; Melting Run Execution)</option>
            <option value="Accounts">Accounts (Read-Only Ledger Oversight &amp; Audit)</option>
          </select>
        </div>

        <div>
          <label for="create_password" class="block text-xs font-mono uppercase text-slate-300 mb-1.5">Initial Password *</label>
          <input 
            type="password" 
            id="create_password" 
            name="password" 
            required 
            minlength="6"
            placeholder="Minimum 6 characters"
            class="w-full bg-slate-950 border border-slate-700 focus:border-purple-500 focus:ring-1 focus:ring-purple-500 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-slate-500 outline-none"
          />
        </div>

        <div>
          <label for="create_confirm" class="block text-xs font-mono uppercase text-slate-300 mb-1.5">Confirm Password *</label>
          <input 
            type="password" 
            id="create_confirm" 
            name="confirm_password" 
            required 
            minlength="6"
            placeholder="Re-enter password"
            class="w-full bg-slate-950 border border-slate-700 focus:border-purple-500 focus:ring-1 focus:ring-purple-500 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-slate-500 outline-none"
          />
        </div>

        <div class="pt-4 border-t border-slate-800 flex items-center justify-end gap-3">
          <button 
            type="button" 
            onclick="closeCreateUserModal()" 
            class="px-4 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-white bg-slate-800 hover:bg-slate-700 transition"
          >
            Cancel
          </button>
          <button 
            type="submit" 
            class="px-4 py-2 rounded-lg text-xs font-semibold bg-purple-600 hover:bg-purple-500 text-white shadow-lg shadow-purple-600/20 transition"
          >
            Save &amp; Provision User
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ================================================================= -->
  <!-- MODAL 2: Reset Password Modal                                     -->
  <!-- ================================================================= -->
  <div id="resetPasswordModal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md p-6 shadow-2xl relative overflow-hidden">
      <div class="flex items-center justify-between pb-4 border-b border-slate-800">
        <div class="flex items-center gap-2">
          <span class="text-indigo-400 font-bold text-lg">🔑</span>
          <h3 class="text-lg font-bold text-white">Reset User Password</h3>
        </div>
        <button type="button" onclick="closeResetPasswordModal()" class="text-slate-400 hover:text-white p-1 rounded-lg">✕</button>
      </div>

      <form action="<%= authUrl('/admin/users/reset-password') %>" method="POST" class="mt-5 space-y-4">
        <input type="hidden" name="auth" value="<%= authToken %>">
        <input type="hidden" id="reset_user_id" name="user_id" value="">

        <div>
          <label class="block text-xs font-mono uppercase text-slate-400 mb-1">Target Account</label>
          <div id="reset_username_display" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-sm text-indigo-300 font-mono font-bold">
            -
          </div>
        </div>

        <div>
          <label for="reset_new_password" class="block text-xs font-mono uppercase text-slate-300 mb-1.5">New Password *</label>
          <input 
            type="password" 
            id="reset_new_password" 
            name="new_password" 
            required 
            minlength="6"
            placeholder="Minimum 6 characters"
            class="w-full bg-slate-950 border border-slate-700 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-slate-500 outline-none"
          />
        </div>

        <div>
          <label for="reset_confirm_password" class="block text-xs font-mono uppercase text-slate-300 mb-1.5">Confirm New Password *</label>
          <input 
            type="password" 
            id="reset_confirm_password" 
            name="confirm_password" 
            required 
            minlength="6"
            placeholder="Re-enter new password"
            class="w-full bg-slate-950 border border-slate-700 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-slate-500 outline-none"
          />
        </div>

        <div class="pt-4 border-t border-slate-800 flex items-center justify-end gap-3">
          <button 
            type="button" 
            onclick="closeResetPasswordModal()" 
            class="px-4 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-white bg-slate-800 hover:bg-slate-700 transition"
          >
            Cancel
          </button>
          <button 
            type="submit" 
            class="px-4 py-2 rounded-lg text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-600/20 transition"
          >
            Update Password
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ================================================================= -->
  <!-- MODAL 3: Change Role Modal                                        -->
  <!-- ================================================================= -->
  <div id="changeRoleModal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md p-6 shadow-2xl relative overflow-hidden">
      <div class="flex items-center justify-between pb-4 border-b border-slate-800">
        <div class="flex items-center gap-2">
          <span class="text-amber-400 font-bold text-lg">🛡️</span>
          <h3 class="text-lg font-bold text-white">Change User Role</h3>
        </div>
        <button type="button" onclick="closeChangeRoleModal()" class="text-slate-400 hover:text-white p-1 rounded-lg">✕</button>
      </div>

      <form action="<%= authUrl('/admin/users/change-role') %>" method="POST" class="mt-5 space-y-4">
        <input type="hidden" name="auth" value="<%= authToken %>">
        <input type="hidden" id="change_user_id" name="user_id" value="">

        <div>
          <label class="block text-xs font-mono uppercase text-slate-400 mb-1">Target Account</label>
          <div id="change_username_display" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-sm text-amber-300 font-mono font-bold">
            -
          </div>
        </div>

        <div>
          <label for="change_new_role" class="block text-xs font-mono uppercase text-slate-300 mb-1.5">Select Role *</label>
          <select 
            id="change_new_role" 
            name="new_role" 
            required
            class="w-full bg-slate-950 border border-slate-700 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 rounded-lg px-3.5 py-2.5 text-sm text-white outline-none"
          >
            <option value="FactoryManager">Factory Manager (Full CRUD &amp; Melting Run Execution)</option>
            <option value="Accounts">Accounts (Read-Only Ledger Oversight &amp; Audit)</option>
          </select>
        </div>

        <div class="pt-4 border-t border-slate-800 flex items-center justify-end gap-3">
          <button 
            type="button" 
            onclick="closeChangeRoleModal()" 
            class="px-4 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-white bg-slate-800 hover:bg-slate-700 transition"
          >
            Cancel
          </button>
          <button 
            type="submit" 
            class="px-4 py-2 rounded-lg text-xs font-semibold bg-amber-500 hover:bg-amber-400 text-slate-950 shadow-lg shadow-amber-500/20 transition"
          >
            Save Role Change
          </button>
        </div>
      </form>
    </div>
  </div>

  <%- include('partials/footer') %>

  <!-- Modal Interactivity Script -->
  <script>
    function openCreateUserModal() {
      const modal = document.getElementById('createUserModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeCreateUserModal() {
      const modal = document.getElementById('createUserModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function openResetPasswordModal(userId, username) {
      document.getElementById('reset_user_id').value = userId;
      document.getElementById('reset_username_display').textContent = username + ' (#' + userId + ')';
      const modal = document.getElementById('resetPasswordModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeResetPasswordModal() {
      const modal = document.getElementById('resetPasswordModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function openChangeRoleModal(userId, username, currentRole) {
      document.getElementById('change_user_id').value = userId;
      document.getElementById('change_username_display').textContent = username + ' (#' + userId + ')';
      document.getElementById('change_new_role').value = currentRole;
      const modal = document.getElementById('changeRoleModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeChangeRoleModal() {
      const modal = document.getElementById('changeRoleModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  </script>
</body>
</html>
