<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Metal Master Catalog - Alloy Vault</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">
  <%- include('partials/navbar') %>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Metal Master Specifications</h1>
          <% if (currentUser.role === 'FactoryManager') { %>
            <span class="text-xs font-mono bg-amber-950 text-amber-300 border border-amber-800 px-2.5 py-1 rounded-full font-semibold">
              FactoryManager Access
            </span>
          <% } else if (currentUser.role === 'Admin') { %>
            <span class="text-xs font-mono bg-purple-950 text-purple-300 border border-purple-800 px-2.5 py-1 rounded-full font-semibold">
              Administrator Oversight
            </span>
          <% } else { %>
            <span class="text-xs font-mono bg-emerald-950 text-emerald-300 border border-emerald-800 px-2.5 py-1 rounded-full font-semibold">
              Auditor Catalog View
            </span>
          <% } %>
        </div>
        <p class="text-sm text-slate-400 mt-1">
          Catalog of precious metals, master alloys, purity standards, and tracking units of measure.
        </p>
      </div>

      <% if (currentUser.role === 'FactoryManager') { %>
        <button 
          type="button" 
          onclick="toggleAddForm()"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold bg-amber-500 hover:bg-amber-400 text-slate-950 shadow-lg shadow-amber-500/20 active:scale-95 transition"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
          </svg>
          <span id="toggleBtnText">Add Metal Specification</span>
        </button>
      <% } %>
    </div>

    <!-- Alert / Toast Messages -->
    <% if (typeof query !== 'undefined' && query.msg) { %>
      <div class="mb-6 p-4 rounded-xl bg-emerald-950/80 border border-emerald-800/80 text-emerald-300 text-sm flex items-center justify-between shadow-lg">
        <div class="flex items-center gap-2.5">
          <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>
            <% if (query.msg === 'metal_added') { %> Metal specification successfully added to catalog. <% } %>
            <% if (query.msg === 'metal_updated') { %> Metal specification updated successfully. <% } %>
            <% if (query.msg === 'metal_deleted') { %> Metal specification deleted from catalog successfully. <% } %>
          </span>
        </div>
        <button onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-emerald-200 text-xs font-mono">Dismiss</button>
      </div>
    <% } %>

    <% if (typeof query !== 'undefined' && query.error) { %>
      <div class="mb-6 p-4 rounded-xl bg-rose-950/80 border border-rose-800/80 text-rose-300 text-sm flex items-center justify-between shadow-lg">
        <div class="flex items-center gap-2.5">
          <svg class="w-5 h-5 text-rose-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>
            <% if (query.error === 'missing_fields') { %> Please fill in all required fields. <% } else if (query.error === 'invalid_metal_id') { %> Invalid metal specification identifier. <% } else { %> <%= query.error %> <% } %>
          </span>
        </div>
        <button onclick="this.parentElement.remove()" class="text-rose-400 hover:text-rose-200 text-xs font-mono">Dismiss</button>
      </div>
    <% } %>

    <!-- Add Metal Specification Form (Expandable) -->
    <% if (currentUser.role === 'FactoryManager') { %>
      <div id="addMetalCard" class="hidden mb-8 bg-slate-900 border border-amber-500/30 rounded-2xl p-6 shadow-xl relative overflow-hidden">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-5">
          <h3 class="text-base font-bold text-white flex items-center gap-2">
            <span class="text-amber-400">✨</span> Add New Metal Specification to Catalog
          </h3>
          <button type="button" onclick="toggleAddForm()" class="text-slate-400 hover:text-white text-xs">Close</button>
        </div>

        <form action="<%= authUrl('/metals/add') %>" method="POST" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
          <input type="hidden" name="auth" value="<%= authToken %>">
          <div>
            <label for="metal_name" class="block text-xs font-medium text-slate-300 uppercase tracking-wider mb-1">Metal / Alloy Name</label>
            <input 
              type="text" 
              id="metal_name" 
              name="metal_name" 
              required 
              placeholder="e.g. Rose Gold 14K" 
              class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500 transition"
            />
          </div>

          <div>
            <label for="purity_grade" class="block text-xs font-medium text-slate-300 uppercase tracking-wider mb-1">Purity Grade</label>
            <input 
              type="text" 
              id="purity_grade" 
              name="purity_grade" 
              required 
              placeholder="e.g. 58.5% Au, Cu/Ag" 
              class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500 transition"
            />
          </div>

          <div>
            <label for="uom" class="block text-xs font-medium text-slate-300 uppercase tracking-wider mb-1">Unit of Measure (UOM)</label>
            <select 
              id="uom" 
              name="uom" 
              class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500 transition"
            >
              <option value="g" selected>Grams (g)</option>
              <option value="kg">Kilograms (kg)</option>
              <option value="oz">Troy Ounces (oz)</option>
            </select>
          </div>

          <div class="flex items-center gap-3">
            <label class="flex items-center gap-2 cursor-pointer text-xs text-slate-300">
              <input type="checkbox" name="track_inventory" value="true" checked class="w-4 h-4 text-amber-500 rounded border-slate-700 focus:ring-amber-500">
              <span>Track Stock</span>
            </label>

            <button 
              type="submit" 
              class="flex-1 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold py-2 px-4 rounded-lg text-sm transition"
            >
              Save Metal
            </button>
          </div>
        </form>
      </div>
    <% } %>

    <!-- Metals Catalog Table -->
    <div class="bg-slate-900/80 border border-slate-800 rounded-2xl shadow-xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="bg-slate-950/90 text-xs uppercase font-mono text-slate-400 border-b border-slate-800">
            <tr>
              <th scope="col" class="px-6 py-3.5 font-semibold">ID</th>
              <th scope="col" class="px-6 py-3.5 font-semibold">Metal / Alloy Name</th>
              <th scope="col" class="px-6 py-3.5 font-semibold">Purity Specification</th>
              <th scope="col" class="px-6 py-3.5 font-semibold">Unit (UOM)</th>
              <th scope="col" class="px-6 py-3.5 font-semibold">Tracking Status</th>
              <th scope="col" class="px-6 py-3.5 font-semibold text-right">Current Vault Stock</th>
              <th scope="col" class="px-6 py-3.5 font-semibold text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 font-mono text-xs">
            <% if (metals.length === 0) { %>
              <tr>
                <td colspan="7" class="px-6 py-12 text-center text-slate-500 italic font-sans">
                  No metals found in catalog.
                </td>
              </tr>
            <% } %>

            <% metals.forEach(m => { %>
              <% 
                const stock = stocksMap[m.metal_id] || 0;
              %>
              <tr class="hover:bg-slate-800/40 transition">
                <td class="px-6 py-4 text-slate-400">#<%= m.metal_id %></td>
                <td class="px-6 py-4 font-sans font-medium text-white">
                  <%= m.metal_name %>
                </td>
                <td class="px-6 py-4 text-slate-300">
                  <span class="bg-slate-800 px-2.5 py-1 rounded border border-slate-700 text-slate-200">
                    <%= m.purity_grade %>
                  </span>
                </td>
                <td class="px-6 py-4 text-slate-400 uppercase">
                  <%= m.uom || 'g' %>
                </td>
                <td class="px-6 py-4 font-sans">
                  <% if (m.track_inventory) { %>
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-400">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Active Tracked
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-slate-500">
                      <span class="w-1.5 h-1.5 rounded-full bg-slate-600"></span> Untracked
                    </span>
                  <% } %>
                </td>
                <td class="px-6 py-4 text-right">
                  <span class="font-bold text-sm <%= stock <= 0 ? 'text-rose-400' : 'text-emerald-400' %>">
                    <%= Number(stock).toLocaleString('en-US', { minimumFractionDigits: 3, maximumFractionDigits: 3 }) %> <%= m.uom || 'g' %>
                  </span>
                </td>
                <td class="px-6 py-4 text-right font-sans whitespace-nowrap">
                  <% if (currentUser && currentUser.role === 'FactoryManager') { %>
                    <div class="inline-flex items-center gap-2">
                      <!-- Record Movement Button -->
                      <a 
                        href="<%= authUrl('/transactions/add?metal_id=' + m.metal_id) %>"
                        class="text-xs text-amber-400 hover:text-amber-300 bg-slate-950 hover:bg-slate-800 px-2.5 py-1.5 rounded border border-amber-500/40 transition font-medium"
                        title="Record vault movement"
                      >
                        + Movement
                      </a>

                      <!-- Edit Button -->
                      <button 
                        type="button" 
                        onclick="openEditMetalModal('<%= m.metal_id %>', '<%= m.metal_name.replace(/'/g, "\\'") %>', '<%= m.purity_grade.replace(/'/g, "\\'") %>', '<%= m.uom || 'g' %>', <%= m.track_inventory ? 'true' : 'false' %>)"
                        class="text-xs text-indigo-300 hover:text-white bg-slate-950 hover:bg-indigo-950/60 px-2.5 py-1.5 rounded border border-slate-700 hover:border-indigo-500/50 transition font-medium"
                        title="Edit metal or alloy specification"
                      >
                        Edit
                      </button>

                      <!-- Delete Button -->
                      <form action="<%= authUrl('/metals/delete/' + m.metal_id) %>" method="POST" class="inline" onsubmit="return confirm('Permanently delete metal \'<%= m.metal_name %>\'? (Will be rejected if transactions or melting rules reference it)');">
                        <input type="hidden" name="auth" value="<%= authToken %>">
                        <input type="hidden" name="metal_id" value="<%= m.metal_id %>">
                        <button 
                          type="submit" 
                          class="text-xs text-rose-400 hover:text-rose-300 bg-slate-950 hover:bg-rose-950/40 px-2.5 py-1.5 rounded border border-slate-700 hover:border-rose-500/50 transition font-medium"
                          title="Delete metal specification"
                        >
                          Delete
                        </button>
                      </form>
                    </div>
                  <% } else { %>
                    <span class="text-xs text-slate-500 font-mono">View-Only</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

  </main>

  <!-- ================================================================= -->
  <!-- MODAL: Edit Metal Specification (FactoryManager Only)             -->
  <!-- ================================================================= -->
  <% if (currentUser && currentUser.role === 'FactoryManager') { %>
    <div id="editMetalModal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-lg p-6 shadow-2xl relative overflow-hidden">
        <div class="flex items-center justify-between pb-4 border-b border-slate-800">
          <div class="flex items-center gap-2">
            <span class="text-amber-400 font-bold text-lg">✏️</span>
            <h3 class="text-lg font-bold text-white">Edit Metal Specification</h3>
          </div>
          <button type="button" onclick="closeEditMetalModal()" class="text-slate-400 hover:text-white p-1 rounded-lg">✕</button>
        </div>

        <form id="editMetalForm" action="<%= authUrl('/metals/edit') %>" method="POST" class="mt-5 space-y-4">
          <input type="hidden" name="auth" value="<%= authToken %>">
          <input type="hidden" id="edit_metal_id" name="metal_id" value="">

          <div>
            <label for="edit_metal_name" class="block text-xs font-mono uppercase text-slate-300 mb-1.5">Metal / Alloy Name *</label>
            <input 
              type="text" 
              id="edit_metal_name" 
              name="metal_name" 
              required 
              placeholder="e.g. Pure Gold, Yellow Gold Alloy"
              class="w-full bg-slate-950 border border-slate-700 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-slate-500 outline-none"
            />
          </div>

          <div>
            <label for="edit_purity_grade" class="block text-xs font-mono uppercase text-slate-300 mb-1.5">Purity Specification *</label>
            <input 
              type="text" 
              id="edit_purity_grade" 
              name="purity_grade" 
              required 
              placeholder="e.g. 24K (99.99%), 18K (75.0%)"
              class="w-full bg-slate-950 border border-slate-700 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 rounded-lg px-3.5 py-2.5 text-sm text-white placeholder-slate-500 outline-none font-mono"
            />
          </div>

          <div>
            <label for="edit_uom" class="block text-xs font-mono uppercase text-slate-300 mb-1.5">Unit of Measure (UOM) *</label>
            <select 
              id="edit_uom" 
              name="uom" 
              required
              class="w-full bg-slate-950 border border-slate-700 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 rounded-lg px-3.5 py-2.5 text-sm text-white outline-none"
            >
              <option value="g">Grams (g)</option>
              <option value="kg">Kilograms (kg)</option>
              <option value="oz">Troy Ounces (oz)</option>
            </select>
          </div>

          <div class="pt-2">
            <label class="flex items-center gap-2.5 cursor-pointer text-xs text-slate-300">
              <input type="checkbox" id="edit_track_inventory" name="track_inventory" value="true" class="w-4 h-4 text-amber-500 rounded border-slate-700 focus:ring-amber-500">
              <span class="font-medium text-white">Track in Vault Stock Balances</span>
            </label>
            <p class="text-[11px] text-slate-500 mt-1">Untracked metals do not accumulate physical inventory balances.</p>
          </div>

          <div class="pt-4 border-t border-slate-800 flex items-center justify-end gap-3">
            <button 
              type="button" 
              onclick="closeEditMetalModal()" 
              class="px-4 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-white bg-slate-800 hover:bg-slate-700 transition"
            >
              Cancel
            </button>
            <button 
              type="submit" 
              class="px-4 py-2 rounded-lg text-xs font-semibold bg-amber-500 hover:bg-amber-400 text-slate-950 shadow-lg shadow-amber-500/20 transition font-bold"
            >
              Save Metal Changes
            </button>
          </div>
        </form>
      </div>
    </div>
  <% } %>

  <%- include('partials/footer') %>

  <script>
    function toggleAddForm() {
      const card = document.getElementById('addMetalCard');
      const btnText = document.getElementById('toggleBtnText');
      if (card && card.classList.contains('hidden')) {
        card.classList.remove('hidden');
        btnText.textContent = 'Hide Form';
        document.getElementById('metal_name').focus();
      } else if (card) {
        card.classList.add('hidden');
        btnText.textContent = 'Add Metal Specification';
      }
    }

    <% if (currentUser && currentUser.role === 'FactoryManager') { %>
      function openEditMetalModal(id, name, purity, uom, track) {
        document.getElementById('edit_metal_id').value = id;
        document.getElementById('edit_metal_name').value = name;
        document.getElementById('edit_purity_grade').value = purity;
        document.getElementById('edit_uom').value = uom || 'g';
        document.getElementById('edit_track_inventory').checked = Boolean(track);

        const form = document.getElementById('editMetalForm');
        form.action = '<%= authUrl("/metals/edit/") %>' + id;

        const modal = document.getElementById('editMetalModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }

      function closeEditMetalModal() {
        const modal = document.getElementById('editMetalModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    <% } %>
  </script>
</body>
</html>
