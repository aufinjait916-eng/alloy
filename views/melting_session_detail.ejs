<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Session #<%= session.session_id %> Breakdown - Alloy Vault</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">
  <%- include('partials/navbar') %>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Breadcrumb / Header -->
    <div class="mb-6">
      <a href="<%= authUrl('/melting/sessions') %>" class="text-xs font-mono text-slate-400 hover:text-amber-400 flex items-center gap-1.5 mb-2 transition">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>Back to Session History</span>
      </a>

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-3">
            <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
              Melting Session #<%= session.session_id %>
            </h1>
            <span class="text-xs font-mono bg-emerald-950 text-emerald-300 border border-emerald-800 px-2.5 py-1 rounded-full">
              Executed
            </span>
          </div>
          <p class="text-xs text-slate-400 mt-1">
            Executed on <%= new Date(session.session_date).toLocaleString() %> &bull; <%= logs.length %> batches processed
          </p>
        </div>

        <div class="flex items-center gap-3">
          <div class="bg-slate-900 border border-slate-800 px-4 py-2 rounded-xl text-right">
            <span class="text-[10px] text-slate-500 uppercase font-mono block">Combined Output</span>
            <span class="text-lg font-bold text-white font-mono"><%= Number(session.total_session_weight_g).toFixed(3) %> g</span>
          </div>
          <div class="bg-slate-900 border border-slate-800 px-4 py-2 rounded-xl text-right">
            <span class="text-[10px] text-slate-500 uppercase font-mono block">Required Alloy (H)</span>
            <span class="text-lg font-bold text-amber-400 font-mono"><%= Number(session.total_session_alloy_h).toFixed(3) %> g</span>
          </div>
          <% if (currentUser && currentUser.role === 'FactoryManager') { %>
            <button 
              type="button" 
              onclick="openDeleteSessionModal()"
              class="px-3 py-2 rounded-xl text-xs font-semibold text-rose-400 hover:text-rose-300 bg-rose-950/40 hover:bg-rose-950/80 border border-rose-800/80 hover:border-rose-600 transition cursor-pointer"
              title="Delete this melting session and restore metal inventory"
            >
              Delete Session
            </button>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Batches Breakdown Cards / Table -->
    <div class="space-y-6">
      <h2 class="text-base font-bold text-white uppercase tracking-wider flex items-center gap-2">
        <span>Crucible Batch Charges</span>
        <span class="text-xs font-mono text-slate-400 font-normal">(<%= logs.length %> Runs)</span>
      </h2>

      <% logs.forEach((log, index) => { %>
        <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl relative overflow-hidden">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-800 pb-4 mb-4">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-slate-950 border border-slate-700 flex items-center justify-center font-mono font-bold text-amber-400 text-sm">
                #<%= index + 1 %>
              </span>
              <div>
                <h3 class="text-base font-bold text-white font-sans"><%= log.scenario_name || 'Standard Melt' %></h3>
                <span class="text-xs font-mono text-slate-400">Target Purity: <strong class="text-amber-300"><%= Number(log.target_purity || 75).toFixed(2) %>%</strong></span>
              </div>
            </div>

            <div class="flex items-center gap-4 text-xs font-mono">
              <div class="text-right">
                <span class="text-slate-500 block text-[10px] uppercase">Charge Target (G)</span>
                <span class="text-white font-bold text-sm"><%= Number(log.total_weight_g).toFixed(3) %> g</span>
              </div>
              <div class="text-right">
                <span class="text-slate-500 block text-[10px] uppercase">Alloy Added (H)</span>
                <span class="text-amber-400 font-bold text-sm"><%= Number(log.total_alloy_h).toFixed(3) %> g</span>
              </div>
            </div>
          </div>

          <!-- Inputs Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 bg-slate-950 p-4 rounded-xl border border-slate-800/80 text-xs font-mono mb-4">
            <div>
              <span class="text-[10px] text-slate-500 uppercase block">C: Pure Weight</span>
              <span class="text-emerald-400 font-bold"><%= Number(log.input_c_pure_weight).toFixed(3) %> g</span>
            </div>
            <div>
              <span class="text-[10px] text-slate-500 uppercase block">D: Pure Purity</span>
              <span class="text-slate-300"><%= Number(log.input_d_pure_purity).toFixed(2) %>%</span>
            </div>
            <div>
              <span class="text-[10px] text-slate-500 uppercase block">E: Metal Weight</span>
              <span class="text-blue-400 font-bold"><%= Number(log.input_e_metal_weight).toFixed(3) %> g</span>
            </div>
            <div>
              <span class="text-[10px] text-slate-500 uppercase block">F: Metal Purity</span>
              <span class="text-slate-300"><%= Number(log.input_f_metal_purity).toFixed(2) %>%</span>
            </div>
          </div>

          <!-- Itemized Alloy Components Issued -->
          <div>
            <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 block mb-2 font-mono">
              Itemized Alloy Breakdown Deducted from Vault Inventory:
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
              <% if (log.details && log.details.length > 0) { %>
                <% log.details.forEach(d => { %>
                  <div class="bg-slate-950/60 border border-slate-800 p-2.5 rounded-lg flex items-center justify-between text-xs">
                    <span class="font-sans font-medium text-slate-300"><%= d.metal_name %></span>
                    <span class="font-mono font-bold text-amber-400"><%= Number(d.issued_weight).toFixed(3) %> <%= d.uom || 'g' %></span>
                  </div>
                <% }); %>
              <% } else { %>
                <span class="text-xs text-slate-500 italic">No component alloy details recorded.</span>
              <% } %>
            </div>
          </div>

        </div>
      <% }); %>
    </div>

  </main>

  <%- include('partials/footer') %>

  <% if (currentUser && currentUser.role === 'FactoryManager') { %>
    <!-- Delete Session Confirmation Modal -->
    <div id="deleteSessionModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
        <div class="flex items-center gap-3 text-rose-400 mb-4">
          <div class="p-2 rounded-lg bg-rose-950 border border-rose-900">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-white">Delete Melting Session</h3>
        </div>

        <p class="text-xs text-slate-300 leading-relaxed mb-4">
          Are you sure you want to delete <strong class="text-amber-400 font-mono">#SESSION-<%= session.session_id %></strong>?
        </p>

        <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800/80 text-xs font-mono mb-4 space-y-1.5">
          <div class="flex justify-between text-slate-400">
            <span>Total Target Weight:</span>
            <span class="text-white font-bold"><%= Number(session.total_session_weight_g).toFixed(3) %> g</span>
          </div>
          <div class="flex justify-between text-slate-400">
            <span>Required Alloy Issued:</span>
            <span class="text-amber-400 font-bold"><%= Number(session.total_session_alloy_h).toFixed(3) %> g</span>
          </div>
          <div class="pt-2 border-t border-slate-800 text-[11px] text-emerald-400 flex items-center gap-1.5 font-sans">
            <span>✓</span>
            <span>All deducted alloy metals will be <strong>restored back to vault inventory</strong>.</span>
          </div>
        </div>

        <form method="POST" action="<%= authUrl('/melting/sessions/delete/' + session.session_id) %>">
          <input type="hidden" name="auth" value="<%= authToken %>">
          <div class="flex items-center justify-end gap-3">
            <button 
              type="button" 
              onclick="closeDeleteSessionModal()"
              class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 transition cursor-pointer"
            >
              Cancel
            </button>
            <button 
              type="submit" 
              class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-rose-600 hover:bg-rose-500 shadow-lg shadow-rose-900/30 transition cursor-pointer"
            >
              Confirm Delete &amp; Restore
            </button>
          </div>
        </form>
      </div>
    </div>

    <script>
      function openDeleteSessionModal() {
        document.getElementById('deleteSessionModal').classList.remove('hidden');
      }

      function closeDeleteSessionModal() {
        document.getElementById('deleteSessionModal').classList.add('hidden');
      }
    </script>
  <% } %>
</body>
</html>
