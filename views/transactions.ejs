<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Transactions History - Alloy &amp; Melting Inventory</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">
  <%- include('partials/navbar') %>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Page Header & Action -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Inventory &amp; Melting Logs</h1>
          <span class="text-xs font-mono bg-slate-800 text-slate-300 px-2.5 py-1 rounded-full border border-slate-700">
            <span id="renderedRowCount"><%= transactions.length %></span> movements
          </span>
        </div>
        <p class="text-sm text-slate-400 mt-1">
          Chronological audit trail of vault receipts, scrap returns, and furnace crucible discharges.
        </p>
      </div>

      <% if (currentUser.role === 'FactoryManager') { %>
        <div class="flex items-center gap-3">
          <a 
            href="<%= authUrl('/transactions/add') %>" 
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold bg-amber-500 hover:bg-amber-400 text-slate-950 shadow-lg shadow-amber-500/20 active:scale-95 transition"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
            </svg>
            <span>Record Movement</span>
          </a>
        </div>
      <% } %>
    </div>

    <!-- Alert Messages -->
    <% if (typeof query !== 'undefined' && query.msg) { %>
      <div class="mb-6 p-4 rounded-xl bg-emerald-950/80 border border-emerald-800/80 text-emerald-300 text-sm flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>
            <% if (query.msg === 'created') { %> New transaction logged and stock balances refreshed. <% } %>
            <% if (query.msg === 'updated') { %> Transaction updated and ledger recalculated. <% } %>
            <% if (query.msg === 'deleted') { %> Transaction removed and stock inventory adjusted. <% } %>
            <% if (query.msg === 'session_deleted') { %> Melting session deleted and metal vault inventory restored successfully. <% } %>
          </span>
        </div>
        <button onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-emerald-200 text-xs font-mono">Dismiss</button>
      </div>
    <% } %>

    <% if (typeof query !== 'undefined' && query.error) { %>
      <div class="mb-6 p-4 rounded-xl bg-rose-950/80 border border-rose-800/80 text-rose-300 text-sm flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <svg class="w-5 h-5 text-rose-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span>
            <% if (query.error === 'melting_tx_locked') { %>
              Transactions originated from melting sessions cannot be directly edited or deleted. Delete the corresponding Melting Session to restore inventory.
            <% } else { %>
              Action could not be completed.
            <% } %>
          </span>
        </div>
        <button onclick="this.parentElement.remove()" class="text-rose-400 hover:text-rose-200 text-xs font-mono">Dismiss</button>
      </div>
    <% } %>

    <!-- Filter & Real-Time Search Toolbar -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 mb-6 shadow-md">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
        
        <!-- Live Real-Time Search Box (Vanilla JS filtering on entity_name / remarks / metal) -->
        <div class="md:col-span-6 relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input 
            type="text" 
            id="searchInput"
            placeholder="Live search by entity remarks, batch #, supplier, or metal name..." 
            class="w-full bg-slate-950 border border-slate-700 rounded-lg pl-10 pr-10 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition"
          />
          <button 
            type="button" 
            id="clearSearchBtn" 
            onclick="clearSearch()"
            class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-xs text-slate-400 hover:text-white"
          >
            &times;
          </button>
        </div>

        <!-- Filter by Type (All / IN / OUT) -->
        <div class="md:col-span-3 flex items-center bg-slate-950 p-1 rounded-lg border border-slate-800">
          <button 
            type="button" 
            onclick="setTypeFilter('ALL')" 
            id="btnFilterAll"
            class="flex-1 py-1.5 text-xs font-medium rounded-md bg-amber-500 text-slate-950 font-semibold transition"
          >
            All
          </button>
          <button 
            type="button" 
            onclick="setTypeFilter('IN')" 
            id="btnFilterIn"
            class="flex-1 py-1.5 text-xs font-medium rounded-md text-slate-400 hover:text-white transition"
          >
            IN
          </button>
          <button 
            type="button" 
            onclick="setTypeFilter('OUT')" 
            id="btnFilterOut"
            class="flex-1 py-1.5 text-xs font-medium rounded-md text-slate-400 hover:text-white transition"
          >
            OUT (Melt)
          </button>
        </div>

        <!-- Filter by Metal -->
        <div class="md:col-span-3">
          <select 
            id="metalFilter" 
            onchange="applyFilters()" 
            class="w-full bg-slate-950 border border-slate-700 text-slate-300 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-amber-500"
          >
            <option value="ALL">All Metals &amp; Alloys</option>
            <% metals.forEach(m => { %>
              <option value="<%= m.metal_id %>"><%= m.metal_name %> (<%= m.purity_grade %>)</option>
            <% }); %>
          </select>
        </div>

      </div>
    </div>

    <!-- Transactions Data Table -->
    <div class="bg-slate-900/80 border border-slate-800 rounded-2xl shadow-xl overflow-hidden">
      <div class="overflow-x-auto">
        <table id="transactionsTable" class="w-full text-left text-sm text-slate-300">
          <thead class="bg-slate-950/90 text-xs uppercase font-mono text-slate-400 border-b border-slate-800">
            <tr>
              <th scope="col" class="px-6 py-3.5 font-semibold">ID</th>
              <th scope="col" class="px-6 py-3.5 font-semibold">Timestamp</th>
              <th scope="col" class="px-6 py-3.5 font-semibold">Metal Spec</th>
              <th scope="col" class="px-6 py-3.5 font-semibold">Movement Type</th>
              <th scope="col" class="px-6 py-3.5 font-semibold text-right">Quantity</th>
              <th scope="col" class="px-6 py-3.5 font-semibold">Entity / Process Remarks</th>
              <% if (currentUser.role === 'FactoryManager') { %>
                <th scope="col" class="px-6 py-3.5 font-semibold text-right">Actions</th>
              <% } %>
            </tr>
          </thead>
          <tbody id="transactionRows" class="divide-y divide-slate-800/60 font-mono text-xs">
            <% if (transactions.length === 0) { %>
              <tr id="emptyRow">
                <td colspan="<%= currentUser.role === 'FactoryManager' ? 7 : 6 %>" class="px-6 py-12 text-center text-slate-500 font-sans text-sm">
                  No inventory transactions recorded.
                </td>
              </tr>
            <% } %>

            <% transactions.forEach(t => { %>
              <tr 
                class="hover:bg-slate-800/40 transition transaction-row"
                data-id="<%= t.transaction_id %>"
                data-metal-id="<%= t.metal_id %>"
                data-metal-name="<%= t.metal_name %>"
                data-purity="<%= t.purity_grade %>"
                data-type="<%= t.transaction_type %>"
                data-qty="<%= t.quantity %>"
                data-uom="<%= t.uom || 'g' %>"
                data-entity="<%= t.entity_name %>"
              >
                <!-- Transaction ID -->
                <td class="px-6 py-4 text-slate-400">
                  #<%= t.transaction_id %>
                </td>

                <!-- Timestamp -->
                <td class="px-6 py-4 text-slate-400 whitespace-nowrap">
                  <%= new Date(t.trans_date).toLocaleString('en-US', { year: 'numeric', month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit' }) %>
                </td>

                <!-- Metal Name & Purity -->
                <td class="px-6 py-4 font-sans">
                  <div class="font-medium text-white"><%= t.metal_name %></div>
                  <div class="text-[11px] text-slate-400 font-mono"><%= t.purity_grade %></div>
                </td>

                <!-- Movement Type Badge -->
                <td class="px-6 py-4 font-sans">
                  <% if (t.transaction_type === 'IN') { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-950/80 text-emerald-300 border border-emerald-800">
                      <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                      </svg>
                      IN (Deposit)
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-950/80 text-amber-300 border border-amber-800">
                      <svg class="w-3 h-3 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                      </svg>
                      OUT (Melt)
                    </span>
                  <% } %>
                </td>

                <!-- Quantity -->
                <td class="px-6 py-4 text-right">
                  <span class="text-sm font-bold <%= t.transaction_type === 'IN' ? 'text-emerald-400' : 'text-amber-400' %>">
                    <%= Number(t.quantity).toLocaleString('en-US', { minimumFractionDigits: 3, maximumFractionDigits: 3 }) %> <%= t.uom || 'g' %>
                  </span>
                </td>

                <!-- Entity Remarks (The search targets this!) -->
                <td class="px-6 py-4 font-sans text-slate-300 entity-cell">
                  <span class="font-medium text-white"><%= t.entity_name %></span>
                </td>

                <!-- Manager Action Buttons (Hidden for Accounts) -->
                <% if (currentUser.role === 'FactoryManager') { %>
                  <td class="px-6 py-4 text-right font-sans whitespace-nowrap">
                    <% 
                      const isMeltingTx = t.entity_name && (t.entity_name.startsWith('Melting Batch #') || t.entity_name.includes('Melting Batch'));
                    %>
                    <% if (isMeltingTx) { %>
                      <% 
                        const match = t.entity_name.match(/Melting Batch #(\d+)/);
                        const sourceSessionId = match ? match[1] : null;
                      %>
                      <div class="inline-flex items-center justify-end gap-1.5">
                        <span class="inline-flex items-center gap-1 text-[11px] font-mono px-2 py-1 rounded bg-slate-950 text-slate-400 border border-slate-800" title="Originated from melting session. Delete the session to restore inventory.">
                          <svg class="w-3 h-3 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                          </svg>
                          <span>Melting Run</span>
                        </span>
                        <% if (sourceSessionId) { %>
                          <a 
                            href="<%= authUrl('/melting/sessions/' + sourceSessionId) %>" 
                            class="text-xs text-amber-400 hover:text-amber-300 font-mono hover:underline px-1.5 py-1 rounded bg-slate-950 border border-slate-800"
                            title="Open Source Melting Session"
                          >
                            #<%= sourceSessionId %>
                          </a>
                        <% } %>
                      </div>
                    <% } else { %>
                      <div class="inline-flex items-center gap-2">
                        <!-- Edit Link -->
                        <a 
                          href="<%= authUrl('/transactions/edit/' + t.transaction_id) %>"
                          class="text-xs text-slate-300 hover:text-amber-400 bg-slate-950 hover:bg-slate-800 px-2.5 py-1.5 rounded border border-slate-700 hover:border-amber-500/50 transition"
                        >
                          Edit
                        </a>

                        <!-- Interactive Delete Trigger -->
                        <button 
                          type="button" 
                          onclick="openDeleteModal('<%= t.transaction_id %>', '<%= t.metal_id %>', '<%= t.metal_name %>', '<%= t.purity_grade %>', '<%= t.transaction_type %>', '<%= t.quantity %>', '<%= t.uom || 'g' %>', '<%= t.entity_name %>')"
                          class="text-xs text-rose-400 hover:text-rose-300 bg-slate-950 hover:bg-rose-950/40 px-2.5 py-1.5 rounded border border-slate-700 hover:border-rose-500/50 transition"
                        >
                          Delete
                        </button>
                      </div>
                    <% } %>
                  </td>
                <% } %>
              </tr>
            <% }); %>

            <!-- No matches row for search filter -->
            <tr id="noMatchRow" class="hidden">
              <td colspan="<%= currentUser.role === 'FactoryManager' ? 7 : 6 %>" class="px-6 py-12 text-center text-slate-500 font-sans text-sm">
                No transactions match the search filters.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </main>

  <!-- Interactive Deletion Modal with Stock Balance Impact Warning -->
  <div 
    id="deleteModal" 
    class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4 transition-opacity"
  >
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-lg w-full p-6 shadow-2xl relative overflow-hidden">
      
      <!-- Top Glow Accent -->
      <div class="absolute -top-12 -right-12 w-32 h-32 bg-rose-500/10 rounded-full blur-2xl pointer-events-none"></div>

      <!-- Modal Header -->
      <div class="flex items-start gap-4 mb-5">
        <div class="w-12 h-12 rounded-xl bg-rose-950/80 border border-rose-800 text-rose-400 flex items-center justify-center shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-bold text-white">Confirm Transaction Deletion</h3>
          <p class="text-xs text-slate-400 mt-0.5">Please review the automatic vault balance impact below.</p>
        </div>
      </div>

      <!-- Transaction Details Box -->
      <div class="bg-slate-950 rounded-xl p-4 border border-slate-800/80 text-xs font-mono space-y-2 mb-4">
        <div class="flex justify-between">
          <span class="text-slate-500">Transaction ID:</span>
          <span id="delModalId" class="text-white font-bold">#</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-500">Metal &amp; Grade:</span>
          <span id="delModalMetal" class="text-white font-sans font-medium">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-500">Movement Type:</span>
          <span id="delModalType" class="font-bold">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-500">Quantity:</span>
          <span id="delModalQty" class="text-amber-400 font-bold">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-500">Entity / Remarks:</span>
          <span id="delModalEntity" class="text-slate-300 font-sans truncate max-w-[200px]">-</span>
        </div>
      </div>

      <!-- AUTOMATIC STOCK BALANCE IMPACT WARNING (Required Feature) -->
      <div id="impactWarningBox" class="p-4 rounded-xl mb-6 text-xs transition border">
        <!-- Injected via JavaScript -->
      </div>

      <!-- Modal Action Buttons -->
      <div class="flex items-center justify-end gap-3">
        <button 
          type="button" 
          onclick="closeDeleteModal()"
          class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-medium transition"
        >
          Cancel
        </button>

        <form id="deleteForm" method="POST" action="">
          <button 
            type="submit" 
            class="px-4 py-2 bg-rose-600 hover:bg-rose-500 text-white rounded-lg text-xs font-bold shadow-lg shadow-rose-600/30 transition flex items-center gap-1.5"
          >
            <span>Proceed &amp; Delete</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>
      </div>

    </div>
  </div>

  <%- include('partials/footer') %>

  <!-- Stock balances mapping for client-side calculation -->
  <script>
    // Live stock map from server
    const currentStocks = <%- JSON.stringify(stocksMap) %>;
    
    let activeTypeFilter = 'ALL';

    // -------------------------------------------------------------
    // Real-Time Client-Side Search & Filter
    // -------------------------------------------------------------
    const searchInput = document.getElementById('searchInput');
    const clearBtn = document.getElementById('clearSearchBtn');
    const metalSelect = document.getElementById('metalFilter');
    const rows = document.querySelectorAll('.transaction-row');
    const noMatchRow = document.getElementById('noMatchRow');
    const renderedRowCount = document.getElementById('renderedRowCount');

    function setTypeFilter(type) {
      activeTypeFilter = type;

      const btnAll = document.getElementById('btnFilterAll');
      const btnIn = document.getElementById('btnFilterIn');
      const btnOut = document.getElementById('btnFilterOut');

      const activeClass = 'bg-amber-500 text-slate-950 font-semibold';
      const inactiveClass = 'text-slate-400 hover:text-white';

      btnAll.className = 'flex-1 py-1.5 text-xs font-medium rounded-md transition ' + (type === 'ALL' ? activeClass : inactiveClass);
      btnIn.className = 'flex-1 py-1.5 text-xs font-medium rounded-md transition ' + (type === 'IN' ? activeClass : inactiveClass);
      btnOut.className = 'flex-1 py-1.5 text-xs font-medium rounded-md transition ' + (type === 'OUT' ? activeClass : inactiveClass);

      applyFilters();
    }

    function clearSearch() {
      searchInput.value = '';
      clearBtn.classList.add('hidden');
      applyFilters();
      searchInput.focus();
    }

    searchInput.addEventListener('input', function() {
      if (this.value.length > 0) {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }
      applyFilters();
    });

    function applyFilters() {
      const query = searchInput.value.trim().toLowerCase();
      const selectedMetalId = metalSelect.value;
      let visibleCount = 0;

      rows.forEach(row => {
        const entityText = row.getAttribute('data-entity').toLowerCase();
        const metalName = row.getAttribute('data-metal-name').toLowerCase();
        const rowType = row.getAttribute('data-type');
        const rowMetalId = row.getAttribute('data-metal-id');

        const matchesQuery = !query || entityText.includes(query) || metalName.includes(query);
        const matchesType = (activeTypeFilter === 'ALL') || (rowType === activeTypeFilter);
        const matchesMetal = (selectedMetalId === 'ALL') || (rowMetalId === selectedMetalId);

        if (matchesQuery && matchesType && matchesMetal) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (renderedRowCount) {
        renderedRowCount.textContent = visibleCount;
      }

      if (noMatchRow) {
        if (visibleCount === 0 && rows.length > 0) {
          noMatchRow.classList.remove('hidden');
        } else {
          noMatchRow.classList.add('hidden');
        }
      }
    }

    // -------------------------------------------------------------
    // Interactive Deletion Modal with Stock Balance Impact Warning
    // -------------------------------------------------------------
    function openDeleteModal(id, metalId, metalName, purity, type, qty, uom, entity) {
      const modal = document.getElementById('deleteModal');
      const deleteForm = document.getElementById('deleteForm');
      
      document.getElementById('delModalId').textContent = '#' + id;
      document.getElementById('delModalMetal').textContent = metalName + ' (' + purity + ')';
      
      const typeSpan = document.getElementById('delModalType');
      if (type === 'IN') {
        typeSpan.textContent = 'IN (Receipt / Scrap)';
        typeSpan.className = 'font-bold text-emerald-400';
      } else {
        typeSpan.textContent = 'OUT (Melting Charge)';
        typeSpan.className = 'font-bold text-amber-400';
      }

      document.getElementById('delModalQty').textContent = Number(qty).toLocaleString('en-US', { minimumFractionDigits: 3, maximumFractionDigits: 3 }) + ' ' + uom;
      document.getElementById('delModalEntity').textContent = entity;

      // Calculate Stock Impact
      const currentBal = Number(currentStocks[metalId] !== undefined ? currentStocks[metalId] : 0);
      const transactionQty = Number(qty);
      let projectedBal = currentBal;

      const impactBox = document.getElementById('impactWarningBox');

      if (type === 'IN') {
        // Deleting an IN subtracts the quantity from current stock!
        projectedBal = currentBal - transactionQty;
        
        let warningHtml = `
          <div class="flex items-start gap-2.5">
            <span class="text-base">⚠️</span>
            <div>
              <div class="font-bold text-slate-200">Stock Inflow Reversal Impact:</div>
              <p class="text-slate-300 mt-1">
                Deleting this <strong class="text-emerald-400">IN</strong> transaction will subtract 
                <strong class="font-mono text-white">${transactionQty.toFixed(3)} ${uom}</strong> from ${metalName}.
              </p>
              <div class="mt-2 pt-2 border-t border-slate-700/60 font-mono text-[11px] flex justify-between">
                <span>Current Vault Balance: <strong class="text-slate-200">${currentBal.toFixed(3)} ${uom}</strong></span>
                <span>Projected Balance: <strong class="${projectedBal < 0 ? 'text-rose-400 font-bold' : 'text-amber-300'}">${projectedBal.toFixed(3)} ${uom}</strong></span>
              </div>
        `;

        if (projectedBal < 0) {
          impactBox.className = 'p-4 rounded-xl mb-6 text-xs bg-rose-950/80 border-rose-800 text-rose-300 shadow-md';
          warningHtml += `
              <div class="mt-2 text-rose-300 font-bold flex items-center gap-1.5">
                <span>⛔ CRITICAL WARNING:</span> Vault stock will drop into a NEGATIVE balance (${projectedBal.toFixed(3)} ${uom})!
              </div>
          `;
        } else {
          impactBox.className = 'p-4 rounded-xl mb-6 text-xs bg-amber-950/80 border-amber-800 text-amber-300 shadow-md';
        }

        warningHtml += `
            </div>
          </div>
        `;
        impactBox.innerHTML = warningHtml;

      } else {
        // Deleting an OUT restores the quantity back to current stock!
        projectedBal = currentBal + transactionQty;

        impactBox.className = 'p-4 rounded-xl mb-6 text-xs bg-blue-950/80 border-blue-800 text-blue-300 shadow-md';
        impactBox.innerHTML = `
          <div class="flex items-start gap-2.5">
            <span class="text-base">ℹ️</span>
            <div>
              <div class="font-bold text-slate-200">Melting Outflow Reversal Impact:</div>
              <p class="text-slate-300 mt-1">
                Deleting this <strong class="text-amber-400">OUT (Melting)</strong> transaction will restore 
                <strong class="font-mono text-emerald-400">+${transactionQty.toFixed(3)} ${uom}</strong> back to ${metalName}.
              </p>
              <div class="mt-2 pt-2 border-t border-blue-900/60 font-mono text-[11px] flex justify-between">
                <span>Current Vault Balance: <strong class="text-slate-200">${currentBal.toFixed(3)} ${uom}</strong></span>
                <span>Projected Balance: <strong class="text-emerald-400 font-bold">${projectedBal.toFixed(3)} ${uom}</strong></span>
              </div>
            </div>
          </div>
        `;
      }

      const activeAuth = '<%= typeof authToken !== "undefined" ? authToken : "" %>' || sessionStorage.getItem('alloy_auth_token');
      const authSuffix = activeAuth ? '?auth=' + encodeURIComponent(activeAuth) : '';
      deleteForm.action = '/transactions/delete/' + id + authSuffix;
      modal.classList.remove('hidden');
    }

    function closeDeleteModal() {
      document.getElementById('deleteModal').classList.add('hidden');
    }

    // Close on escape key
    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeDeleteModal();
      }
    });
  </script>
</body>
</html>
