<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= mode === 'create' ? 'Create Melting Rule' : 'Edit Rule #' + rule.rule_id %> - Alloy &amp; Melting Inventory</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">
  <%- include('partials/navbar') %>

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Breadcrumb / Header -->
    <div class="mb-6">
      <a href="<%= authUrl('/rules') %>" class="text-xs font-mono text-slate-400 hover:text-amber-400 flex items-center gap-1.5 mb-2 transition">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>Back to Melting Rules Catalog</span>
      </a>

      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold text-white tracking-tight">
            <%= mode === 'create' ? 'Configure New Melting Scenario' : 'Modify Melting Rule #' + rule.rule_id %>
          </h1>
          <p class="text-xs text-slate-400 mt-1">
            Specify target purity, computation formula parameter, validation limits, and component alloy proportions.
          </p>
        </div>
        <span class="text-xs font-mono bg-amber-950 text-amber-300 border border-amber-800 px-2.5 py-1 rounded-full">
          FactoryManager
        </span>
      </div>
    </div>

    <!-- Error Alert -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 p-4 rounded-xl bg-rose-950/80 border border-rose-800/80 text-rose-300 text-sm flex items-start gap-3">
        <svg class="w-5 h-5 text-rose-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <strong class="font-semibold">Validation Error:</strong>
          <p class="mt-0.5"><%= error %></p>
        </div>
      </div>
    <% } %>

    <!-- Form Container -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl">
      <form 
        action="<%= authUrl(mode === 'create' ? '/rules/create' : '/rules/edit/' + rule.rule_id) %>" 
        method="POST" 
        id="ruleForm"
        onsubmit="return validateComponentsSum()"
        class="space-y-6"
      >
        <input type="hidden" name="auth" value="<%= authToken %>">

        <!-- Scenario Name -->
        <div>
          <label for="scenario_name" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Scenario / Alloy Standard Name <span class="text-rose-400">*</span>
          </label>
          <input 
            type="text" 
            id="scenario_name" 
            name="scenario_name" 
            required 
            maxlength="100"
            value="<%= mode === 'edit' ? rule.scenario_name : '' %>"
            placeholder="e.g. 18K Yellow Gold Casting Standard, 925 Sterling Silver Master Bar" 
            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition"
          />
        </div>

        <!-- Target Purity & Compute Parameter Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <!-- Target Purity -->
          <div>
            <label for="target_purity" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              Target Purity (%) <span class="text-rose-400">*</span>
            </label>
            <div class="relative">
              <input 
                type="number" 
                step="0.01" 
                min="0.01" 
                max="100.00" 
                id="target_purity" 
                name="target_purity" 
                required 
                value="<%= mode === 'edit' ? Number(rule.target_purity).toFixed(2) : '75.00' %>"
                placeholder="75.00" 
                class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white font-mono placeholder-slate-600 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition"
              />
              <span class="absolute inset-y-0 right-0 pr-4 flex items-center text-xs font-mono text-slate-500">%</span>
            </div>
            <p class="text-[11px] text-slate-500 mt-1">E.g., 75.00 for 18K, 58.50 for 14K, 92.50 for 925</p>
          </div>

          <!-- Compute Parameter Selection -->
          <div>
            <label for="compute_parameter" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              Formula Compute Variable <span class="text-rose-400">*</span>
            </label>
            <select 
              id="compute_parameter" 
              name="compute_parameter" 
              required 
              onchange="onComputeVarChange()"
              class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition"
            >
              <option value="E" <%= (mode === 'edit' && rule.compute_parameter === 'E') || (mode === 'create') ? 'selected' : '' %>>
                Calculate 'E' (Metal Weight = C &times; %)
              </option>
              <option value="C" <%= (mode === 'edit' && rule.compute_parameter === 'C') ? 'selected' : '' %>>
                Calculate 'C' (Pure Weight = E &times; %)
              </option>
              <option value="None" <%= (mode === 'edit' && rule.compute_parameter === 'None') ? 'selected' : '' %>>
                None (Direct Weight &amp; Purity Conversion)
              </option>
            </select>
            <p id="computeVarHelp" class="text-[11px] text-slate-500 mt-1">Which variable is computed automatically</p>
          </div>

          <!-- Compute Percentage as Ratio Multiplier (%) -->
          <div id="computePctContainer" class="transition">
            <label for="compute_percentage" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              Ratio Multiplier (%) <span id="computePctRequired" class="text-rose-400">*</span>
            </label>
            <div class="relative">
              <input 
                type="number" 
                step="0.0001" 
                min="0.0000" 
                id="compute_percentage" 
                name="compute_percentage" 
                required 
                value="<%= mode === 'edit' ? Number(rule.compute_percentage).toFixed(2) : '142.86' %>"
                placeholder="142.86" 
                class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white font-mono placeholder-slate-600 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition"
              />
              <span class="absolute inset-y-0 right-0 pr-4 flex items-center text-xs font-mono text-slate-500">%</span>
            </div>
            <p id="computePctHelp" class="text-[11px] text-slate-500 mt-1">Entered as percentage: e.g. enter 142.86 for 1.4286 ratio, or 25.00 for 0.25 ratio.</p>
          </div>
        </div>

        <!-- Validation Range Limits -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-slate-950/60 p-4 rounded-xl border border-slate-800">
          <div>
            <label for="purity_min" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Purity Min Limit (%) <span class="text-rose-400">*</span>
            </label>
            <input 
              type="number" 
              step="0.01" 
              min="0.00" 
              max="100.00" 
              id="purity_min" 
              name="purity_min" 
              required 
              value="<%= mode === 'edit' ? Number(rule.purity_min).toFixed(2) : '50.00' %>"
              class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white font-mono focus:outline-none focus:border-amber-500 transition"
            />
          </div>

          <div>
            <label for="purity_max" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Purity Max Limit (%) <span class="text-rose-400">*</span>
            </label>
            <input 
              type="number" 
              step="0.01" 
              min="0.00" 
              max="100.00" 
              id="purity_max" 
              name="purity_max" 
              required 
              value="<%= mode === 'edit' ? Number(rule.purity_max).toFixed(2) : '80.00' %>"
              class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white font-mono focus:outline-none focus:border-amber-500 transition"
            />
          </div>
        </div>

        <!-- DYNAMIC MULTI-METAL ALLOY COMPONENTS BUILDER -->
        <div class="border-t border-slate-800 pt-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
            <div>
              <h3 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
                <span>Alloy Component Breakdown Proportion</span>
                <span class="text-rose-400">*</span>
              </h3>
              <p class="text-xs text-slate-400 mt-0.5">
                Constituent alloy metals that satisfy Required Alloy (H). Must sum to exactly 100%.
              </p>
            </div>

            <!-- Total Percentage Live Badge -->
            <div id="componentsTotalBadge" class="px-3 py-1 rounded-full text-xs font-mono font-bold flex items-center gap-2 bg-slate-800 text-slate-300">
              <span>Total:</span>
              <span id="componentsTotalSum">0.00%</span>
            </div>
          </div>

          <!-- Components Rows Container -->
          <div id="componentsContainer" class="space-y-3 mb-4">
            <!-- Dynamically injected rows via JavaScript -->
          </div>

          <div class="flex items-center justify-between pt-2">
            <button 
              type="button" 
              onclick="addComponentRow()"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-amber-300 border border-slate-700 transition"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
              </svg>
              <span>Add Another Alloy Metal</span>
            </button>

            <span id="sumErrorMsg" class="hidden text-xs text-rose-400 font-semibold flex items-center gap-1">
              <span>⚠️ Proportions must sum to exactly 100%</span>
            </span>
          </div>
        </div>

        <!-- Form Actions -->
        <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-800">
          <a 
            href="<%= authUrl('/rules') %>" 
            class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-medium transition"
          >
            Cancel
          </a>
          <button 
            type="submit" 
            id="submitBtn"
            class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 text-sm font-bold shadow-lg shadow-amber-500/20 active:scale-95 transition"
          >
            <%= mode === 'create' ? 'Save Melting Rule' : 'Update Rule Settings' %>
          </button>
        </div>

      </form>
    </div>

  </main>

  <%- include('partials/footer') %>

  <!-- Raw Catalog of Metals for Dynamic Component Rows -->
  <script>
    const metalsCatalog = <%- JSON.stringify(metals) %>;
    const initialComponents = <%- JSON.stringify(mode === 'edit' && rule.components ? rule.components : []) %>;

    const container = document.getElementById('componentsContainer');

    function createRowHtml(metalId = '', percentage = '') {
      let optionsHtml = '<option value="" disabled selected>-- Select Metal --</option>';
      metalsCatalog.forEach(m => {
        const isSelected = metalId == m.metal_id ? 'selected' : '';
        optionsHtml += `<option value="${m.metal_id}" ${isSelected}>${m.metal_name} (${m.purity_grade})</option>`;
      });

      return `
        <div class="component-row grid grid-cols-12 gap-3 items-center bg-slate-950 p-3 rounded-xl border border-slate-800/80">
          <div class="col-span-7">
            <select name="component_metal_id[]" required onchange="recalcTotalSum()" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500">
              ${optionsHtml}
            </select>
          </div>
          <div class="col-span-4 relative">
            <input 
              type="number" 
              name="component_percentage[]" 
              step="0.01" 
              min="0.01" 
              max="100.00" 
              required 
              value="${percentage}" 
              placeholder="e.g. 60" 
              oninput="recalcTotalSum()"
              class="w-full bg-slate-900 border border-slate-700 rounded-lg pl-3 pr-7 py-2 text-xs text-white font-mono focus:outline-none focus:border-amber-500"
            />
            <span class="absolute inset-y-0 right-0 pr-3 flex items-center text-xs font-mono text-slate-500 pointer-events-none">%</span>
          </div>
          <div class="col-span-1 text-center">
            <button type="button" onclick="removeComponentRow(this)" class="text-rose-400 hover:text-rose-300 text-sm p-1 rounded hover:bg-slate-800 transition" title="Remove component">
              &times;
            </button>
          </div>
        </div>
      `;
    }

    function addComponentRow(metalId = '', percentage = '') {
      const div = document.createElement('div');
      div.innerHTML = createRowHtml(metalId, percentage);
      container.appendChild(div.firstElementChild);
      recalcTotalSum();
    }

    function removeComponentRow(btn) {
      const row = btn.closest('.component-row');
      if (document.querySelectorAll('.component-row').length > 1) {
        row.remove();
        recalcTotalSum();
      } else {
        alert('Melting rule must define at least one alloy component.');
      }
    }

    function recalcTotalSum() {
      const inputs = document.querySelectorAll('input[name="component_percentage[]"]');
      let sum = 0;
      inputs.forEach(input => {
        sum += parseFloat(input.value) || 0;
      });

      const badge = document.getElementById('componentsTotalBadge');
      const sumLabel = document.getElementById('componentsTotalSum');
      const errorMsg = document.getElementById('sumErrorMsg');
      const submitBtn = document.getElementById('submitBtn');

      sumLabel.textContent = sum.toFixed(2) + '%';

      if (Math.abs(sum - 100) < 0.001) {
        badge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold flex items-center gap-2 bg-emerald-950 text-emerald-300 border border-emerald-800';
        errorMsg.classList.add('hidden');
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      } else {
        badge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold flex items-center gap-2 bg-rose-950 text-rose-300 border border-rose-800';
        errorMsg.classList.remove('hidden');
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
      }
    }

    function validateComponentsSum() {
      const inputs = document.querySelectorAll('input[name="component_percentage[]"]');
      let sum = 0;
      inputs.forEach(input => {
        sum += parseFloat(input.value) || 0;
      });

      if (Math.abs(sum - 100) > 0.01) {
        alert(`Components percentage must sum to exactly 100%. Current sum is ${sum.toFixed(2)}%`);
        return false;
      }
      return true;
    }

    function onComputeVarChange() {
      const sel = document.getElementById('compute_parameter').value;
      const pctContainer = document.getElementById('computePctContainer');
      const pctInput = document.getElementById('compute_percentage');
      const pctHelp = document.getElementById('computePctHelp');
      const pctRequired = document.getElementById('computePctRequired');
      const varHelp = document.getElementById('computeVarHelp');

      if (sel === 'None') {
        pctInput.value = '0.00';
        pctInput.required = false;
        if (pctRequired) pctRequired.classList.add('hidden');
        if (pctHelp) pctHelp.textContent = 'Not applicable for "None" variable. Computation will be evaluated directly on the weight and purity entered in crucible preparation.';
        if (varHelp) varHelp.textContent = 'Direct conversion: Calculates target weight (G) and required alloy (H) directly from user-entered weight and purity';
        pctContainer.classList.add('opacity-50');
      } else {
        if (pctInput.value === '0' || pctInput.value === '0.00' || !pctInput.value) {
          pctInput.value = '100.00';
        }
        pctInput.required = true;
        if (pctRequired) pctRequired.classList.remove('hidden');
        if (pctHelp) pctHelp.textContent = 'Entered as percentage: e.g. enter 142.86 for 1.4286 ratio, or 25.00 for 0.25 ratio.';
        if (varHelp) varHelp.textContent = 'Which variable is computed automatically';
        pctContainer.classList.remove('opacity-50');
      }
    }

    // Populate initial rows
    document.addEventListener('DOMContentLoaded', function() {
      if (initialComponents && initialComponents.length > 0) {
        initialComponents.forEach(c => {
          addComponentRow(c.metal_id, (Number(c.percentage) * 100).toFixed(2));
        });
      } else {
        // Defaults: Copper 60%, Silver 40% if available
        addComponentRow(3, '60.00');
        addComponentRow(2, '40.00');
      }
      recalcTotalSum();
      onComputeVarChange();
    });
  </script>
</body>
</html>
